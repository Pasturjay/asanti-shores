# Base Site URL for Canonical URLs, OpenGraph, and XML Sitemap
NEXT_PUBLIC_SITE_URL="https://asantishores.com"

# Public Contact Details
NEXT_PUBLIC_CONTACT_EMAIL="asantishores@gmail.com"
NEXT_PUBLIC_CONTACT_PHONE="+234 916 259 9586"
NEXT_PUBLIC_WHATSAPP_NUMBER="2349162599586"

# Server-Side Email Delivery Target (for quotation & contact notifications)
CONTACT_RECIPIENT_EMAIL="asantishores@gmail.com"

# Transactional Email Provider (Optional - Resend API Key)
# When provided, all incoming quotations and contact submissions will be dispatched to CONTACT_RECIPIENT_EMAIL
# If omitted, submissions are securely validated and logged to server output without failing.
# RESEND_API_KEY="re_1234567890abcdef"

# Database Storage (Optional - PostgreSQL)
# If quotation persistence in a dedicated database is required:
# DATABASE_URL="postgresql://user:password@localhost:5432/asanti_maritime?schema=public"
